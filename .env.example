# Mathpix OCR API credentials
# 발급 전까지는 비워두면 서버가 자동으로 목(mock) 인식 결과를 반환합니다.
# https://mathpix.com/ 에서 앱 등록 후 아래 값을 채워주세요.
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# Supabase (로그인 / 오답·실모 저장 / PDF 내보내기용 데이터)
# https://supabase.com/dashboard 에서 프로젝트 생성 후 Project Settings > API에서 확인
# 값이 비어 있으면 로그인이 필요한 기능들은 안내 메시지만 표시됩니다.
# 로그인은 이메일/비밀번호 방식입니다(Authentication > Providers의 Email이 기본 활성화되어 있으면 됨).
# supabase/migrations/0001_init.sql을 SQL Editor에서 실행해 테이블/버킷을 만들어야 합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 그림(수학 도형·사과탐 자료) AI 재구성 (선택). 없으면 "원본 그대로 붙이기"만
# 할 수 있고(무료), AI 재구성 버튼이 비활성화됩니다.
OPENAI_API_KEY=

# 자료를 다시 그릴 이미지 생성 모델 후보(쉼표 구분, 앞에서부터 시도).
# 비워두면 코드의 기본 후보를 쓰고, 404/403이 나면 다음 후보로 자동으로 내려갑니다.
# **이름을 추측하지 말고** 로그인 후 /api/figure/models 를 열어 usable에 나온
# 이름을 그대로 넣으세요. 이 저장소에서 이름을 추측했다가 404를 여러 번 맞았습니다.
OPENAI_FIGURE_IMAGE_MODELS=

# AI 그림 생성 1회에 차감할 토큰 수(기본 50). 문제 인식 1회는 1토큰입니다.
FIGURE_TOKEN_COST=
